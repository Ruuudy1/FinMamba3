# The execution engine is vendored into src/finmamba3/backtester/engine, so the external checkout is dead weight.
tmppolymarket-bot/

# Experiment tracking and run artifacts (gigabytes; never needed in the image).
wandb/
runs/
reports/

# Datasets and checkpoints are mounted or downloaded at runtime, not baked into the image.
data/
*.ckpt
*.pt
*.safetensors

# Compiled native-engine artifacts; rebuilt inside the image. A stale host copy (Windows .pyd, or a
# .so for a different Python ABI) makes the in-image `python -m engine_cpp.build` fail: the package
# __init__ globs _engine*.{pyd,so}, finds the stale file, and `from . import _engine` errors before
# build.py runs. Keep the source _engine.cpp (patterns below match only the build products).
**/engine_cpp/_engine*.pyd
**/engine_cpp/_engine*.so
**/engine_cpp/_engine*.obj
**/engine_cpp/_engine*.lib
**/engine_cpp/_engine*.exp
**/engine_cpp/_build_tmp/

# VCS, caches, editor/agent state.
.git/
**/__pycache__/
*.pyc
.pytest_cache/
.claude/

# Local research notes and LaTeX build artifacts.
*.pdf
*.aux
*.log
*.out
